{
  "name": "camerawork",
  "version": "0.1.0",
  "description": "Turn screen recordings into guided video tours: automatic zoom and pan to what changes, with a presentation look.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GustavoGomez092/camerawork.git"
  },
  "homepage": "https://github.com/GustavoGomez092/camerawork#readme",
  "bugs": {
    "url": "https://github.com/GustavoGomez092/camerawork/issues"
  },
  "keywords": [
    "screen recording",
    "video",
    "zoom",
    "demo",
    "ffmpeg",
    "product video"
  ],
  "bin": {
    "camerawork": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "node scripts/prepare.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "prepublishOnly": "bun run lint && bun run typecheck && bun test && bun run build"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
